# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# SUPABASE POSTGRESQL & AUTH CONFIGURATION
# Lấy từ Project Settings -> API trên dashboard https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# JWT SECRET (Khớp với JWT Secret trên Supabase hoặc secret dùng riêng)
JWT_SECRET=super_secret_jwt_key_2ce_coffee_roastery_2026

# NODEMAILER (GỬI EMAIL TỰ ĐỘNG CHO QUẢN LÝ VÀ NHÂN SỰ)
# Hỗ trợ Gmail App Password, Resend SMTP, SendGrid hoặc Mailtrap
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notification@2cecoffee.vn
SMTP_PASS=your-app-specific-password
EMAIL_FROM="2CE Coffee Scheduling" <notification@2cecoffee.vn>

# THỜI GIAN ĐẾM NGƯỢC GIAI ĐOẠN 3 (Tính bằng giờ, mặc định 5 giờ)
COUNTDOWN_HOURS=5

